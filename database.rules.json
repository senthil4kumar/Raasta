{
  "rules": {
    "groups": {
      "$code": {
        ".read": "auth != null",
        "created": { ".write": "auth != null && !data.exists()" },
        "route": { ".write": "auth != null" },
        "riders": {
          "$uid": { ".write": "auth != null && auth.uid === $uid" }
        },
        "rtc": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null"
          }
        }
      }
    }
  }
}
